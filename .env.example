# Phase 0 runs without environment variables or a database.
# Reserved for the database phase. Copy this file to .env.local when needed.
# Pooled PostgreSQL connection for the application (server only):
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# Direct PostgreSQL connection for controlled Prisma migrations (server only):
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
