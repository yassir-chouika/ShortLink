# Copy to .env.local for local development. These credentials are local-only.
# Rendering the home page, client generation, and builds need no database URL.
DATABASE_URL="postgresql://shortlink:shortlink@127.0.0.1:5432/shortlink"
DIRECT_URL="postgresql://shortlink:shortlink@127.0.0.1:5432/shortlink"
TEST_DATABASE_URL="postgresql://shortlink:shortlink@127.0.0.1:5432/shortlink_test"

# For Neon, copy the provider's full TLS connection URLs into ignored env files:
# DATABASE_URL uses the pooled host; DIRECT_URL uses the direct host.
# Tests accept only local databases whose names end in _test.

# Optional operator controls. Existing redirects still work when creation is paused.
LINK_CREATION_ENABLED="true"
# Comma-separated hostnames; blocks each host and its subdomains on create/redirect.
BLOCKED_LINK_HOSTS=""
# Required on Vercel: generate a private 32-byte value with `openssl rand -hex 32`.
# Set separately in Vercel Preview and Production; never use a NEXT_PUBLIC_ prefix.
# RATE_LIMIT_SECRET=""
# Vercel sets VERCEL=1. Do not set it on directly reachable local/self-hosted servers.
# RATE_LIMIT_SCOPE defaults to creation. Keep it constant; tests use isolated scopes.
