# Copy to .env.local for local development. These credentials are local-only.
# The introduction page, client generation, and builds need no database URL.
DATABASE_URL="postgresql://shortlink:shortlink@127.0.0.1:5432/shortlink"
DIRECT_URL="postgresql://shortlink:shortlink@127.0.0.1:5432/shortlink"
TEST_DATABASE_URL="postgresql://shortlink:shortlink@127.0.0.1:5432/shortlink_test"

# For Neon, copy the provider's full TLS connection URLs into ignored env files:
# DATABASE_URL uses the pooled host; DIRECT_URL uses the direct host.
# Tests accept only local databases whose names end in _test.
